# DocuMind AI environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- General ---------------------------------------------------------
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Database (REQUIRED) ---------------------------------------------
# Must use the asyncpg driver: postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://documind:change-me@localhost:5432/documind
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# --- OpenAI (REQUIRED) -----------------------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_TIMEOUT=30
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
CHAT_MODEL=gpt-4o-mini

# --- Retrieval & ingestion -------------------------------------------
RETRIEVAL_TOP_K=5
# Minimum cosine similarity (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.70
# Upload size cap in MB (maximum 20)
MAX_UPLOAD_SIZE_MB=20
DOCUMENT_STORAGE_DIR=storage/documents
